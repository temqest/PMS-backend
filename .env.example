NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_SYSTEM_URL=https://admin-subystem.onrender.com
AUDIT_LOG_API_URL=https://admin-subystem.onrender.com/admin/api/audit-logs
SUBSYSTEM_API_KEY=your_key_here
AUDIT_LOG_TIMEOUT_MS=3000
AUDIT_LOG_RETRY_COUNT=1
PRESCRIPTION_API_URL=https://inventory-pharmaceutical-subsystem.vercel.app/api/inventory
PRESCRIPTION_API_KEY=
PRESCRIPTION_API_BEARER_TOKEN=
ML_SERVICE_URL=https://your-ml-service.onrender.com
ML_SERVICE_INTERNAL_URL=
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
